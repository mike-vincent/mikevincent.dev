---
import '../styles/theme.css';
import AgentDiscovery from '../components/site/AgentDiscovery.astro';

interface Props { title: string; description?: string; image?: string; pageClass?: string; }
const { title, description = 'Mike Vincent, Staff Software Engineer', image } = Astro.props;
const path = Astro.url.pathname;
const ogImage = image || 'https://mikevincent.dev/og.png';
const canonical = new URL(path, 'https://mikevincent.dev');
---
<!doctype html>
<html lang="en-US" class="scroll-smooth">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" href="/icon.svg" type="image/svg+xml" />
  <link rel="alternate icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/icon.png" />
  <link rel="canonical" href={canonical} />
  <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
  <link rel="preload" href="/fonts/material-symbols-outlined.woff2" as="font" type="font/woff2" crossorigin />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
  <script is:inline>
    (function () {
      const ICONS = { system: 'contrast', light: 'light_mode', dark: 'dark_mode' };
      const LABELS = { system: 'System theme', light: 'Light theme', dark: 'Dark theme' };
      const mq = matchMedia('(prefers-color-scheme: dark)');
      function applyTheme() {
        const mode = localStorage.getItem('theme') || 'system';
        const dark = mode === 'dark' || (mode === 'system' && mq.matches);
        document.documentElement.classList.toggle('dark', dark);
        document.querySelectorAll('meta[name="theme-color"]').forEach((m) => {
          m.content = dark ? '#000000' : '#ffffff';
        });
        const btn = document.getElementById('theme-toggle');
        if (btn) {
          btn.querySelector('.theme-icon').textContent = ICONS[mode];
          btn.setAttribute('aria-label', LABELS[mode]);
          btn.setAttribute('title', LABELS[mode]);
        }
      }
      window.applyTheme = applyTheme;
      applyTheme();
      mq.addEventListener('change', () => {
        if ((localStorage.getItem('theme') || 'system') === 'system') applyTheme();
      });
      document.addEventListener('DOMContentLoaded', applyTheme);
    })();
  </script>
  <AgentDiscovery />
  <slot name="head" />
</head>
<body class="min-h-svh bg-background text-foreground">
  <header id="site-header" class="sticky top-0 z-50 w-full border-b bg-background/80 backdrop-blur-md supports-[backdrop-filter]:bg-background/60">
    <div class="mx-auto flex h-[60px] max-w-[816px] items-center gap-2 px-5 sm:gap-3 sm:px-6">
      <a id="header-inline-title" href="/" class="flex min-h-11 min-w-0 flex-1 items-center gap-3 overflow-hidden rounded-md -translate-y-2 opacity-0 pointer-events-none transition-all duration-200 outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50">
        <span class="relative flex size-9 shrink-0 overflow-hidden rounded-full bg-muted ring-1 ring-border">
          <img src="/assets/images/headshot-108.webp" alt="Mike Vincent" width="36" height="36" class="aspect-square size-full object-cover" />
        </span>
        <span class="flex min-w-0 flex-col">
          <span class="truncate text-body font-semibold text-foreground">Mike Vincent</span>
          <span class="truncate text-footnote text-muted-foreground">Staff Software Engineer</span>
        </span>
      </a>
      <nav class="flex shrink-0 items-center gap-1">
        <button id="theme-toggle" type="button" aria-label="System theme" title="System theme"
          class="inline-flex size-11 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground cursor-pointer">
          <span class="material-symbols-outlined theme-icon text-[18px]">contrast</span>
        </button>
        <a href="/#resume" class="inline-flex h-10 items-center rounded-[12px] bg-tint px-4 text-subhead font-medium whitespace-nowrap text-white shadow-xs transition-opacity hover:opacity-90 outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50">See Resume</a>
      </nav>
    </div>
  </header>

  <main class="mx-auto max-w-[816px] px-5 sm:px-6"><slot /></main>

  <footer class="mx-auto max-w-[816px] px-5 pb-10 sm:px-6">
    <div class="border-t pt-6 text-footnote text-muted-foreground">
      Copyright &copy; {new Date().getFullYear()} Mike Vincent. Los Angeles, CA &middot; U.S. Citizen.
    </div>
  </footer>

  <script is:inline>
    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const mode = localStorage.getItem('theme') || 'system';
      localStorage.setItem('theme', mode === 'system' ? 'light' : mode === 'light' ? 'dark' : 'system');
      window.applyTheme();
    });

    (function () {
      const header = document.getElementById('site-header');
      const inlineTitle = document.getElementById('header-inline-title');
      const heroTitle = document.querySelector('main h1');
      if (!header || !inlineTitle) return;

      function setVisible(visible) {
        inlineTitle.classList.toggle('-translate-y-2', !visible);
        inlineTitle.classList.toggle('translate-y-0', visible);
        inlineTitle.classList.toggle('opacity-0', !visible);
        inlineTitle.classList.toggle('opacity-100', visible);
        inlineTitle.classList.toggle('pointer-events-none', !visible);
      }

      if (!heroTitle || typeof IntersectionObserver === 'undefined') {
        setVisible(true);
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          const entry = entries[0];
          setVisible(!entry.isIntersecting && entry.boundingClientRect.top < 60);
        },
        { rootMargin: '-60px 0px 0px 0px', threshold: 0 }
      );
      observer.observe(heroTitle);
    })();
  </script>
  <AgentDiscovery form />
</body>
</html>
