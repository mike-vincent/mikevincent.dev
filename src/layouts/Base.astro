---
import '../styles/theme.css';

interface Props { title: string; description?: string; image?: string; pageClass?: string; }
const { title, description = 'Mike Vincent, Staff Software Engineer', image } = Astro.props;
const path = Astro.url.pathname;
const ogImage = image || 'https://mikevincent.dev/og.png';
const canonical = new URL(path, 'https://mikevincent.dev');
---
<!doctype html>
<html lang="en-US" class="scroll-smooth">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" href="/icon.svg" type="image/svg+xml" />
  <link rel="alternate icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/icon.png" />
  <link rel="canonical" href={canonical} />
  <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=contrast,dark_mode,download,light_mode" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#171717" media="(prefers-color-scheme: dark)" />
  <script is:inline>
    (function () {
      const ICONS = { system: 'contrast', light: 'light_mode', dark: 'dark_mode' };
      const LABELS = { system: 'System theme', light: 'Light theme', dark: 'Dark theme' };
      const mq = matchMedia('(prefers-color-scheme: dark)');
      function applyTheme() {
        const mode = localStorage.getItem('theme') || 'system';
        const dark = mode === 'dark' || (mode === 'system' && mq.matches);
        document.documentElement.classList.toggle('dark', dark);
        document.querySelectorAll('meta[name="theme-color"]').forEach((m) => {
          m.content = dark ? '#171717' : '#ffffff';
        });
        const btn = document.getElementById('theme-toggle');
        if (btn) {
          btn.querySelector('.theme-icon').textContent = ICONS[mode];
          btn.setAttribute('aria-label', LABELS[mode]);
          btn.setAttribute('title', LABELS[mode]);
        }
      }
      window.applyTheme = applyTheme;
      applyTheme();
      mq.addEventListener('change', () => {
        if ((localStorage.getItem('theme') || 'system') === 'system') applyTheme();
      });
      document.addEventListener('DOMContentLoaded', applyTheme);
    })();
  </script>
  <slot name="head" />
</head>
<body class="min-h-svh bg-background text-foreground">
  <header class="sticky top-0 z-50 w-full border-b bg-background/80 backdrop-blur-md supports-[backdrop-filter]:bg-background/60">
    <div class="mx-auto flex h-16 max-w-4xl items-center gap-0 px-4 sm:gap-3 sm:px-6">
      <a href="/" class="flex items-center gap-3 rounded-md outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50">
        <span class="relative flex size-9 shrink-0 overflow-hidden rounded-full bg-muted">
          <img src="/assets/images/headshot.jpg" alt="Mike Vincent" class="aspect-square size-full object-cover" />
        </span>
        <span class="flex min-w-0 flex-col leading-tight">
          <span class="whitespace-nowrap text-sm font-semibold tracking-tight">Mike Vincent</span>
          <span class="whitespace-nowrap text-xs text-muted-foreground">Staff Software Engineer</span>
        </span>
      </a>
      <div class="flex-1"></div>
      <nav class="flex items-center sm:gap-1">
        <a href="/#resume" class="inline-flex h-8 items-center rounded-md px-2 text-sm font-medium whitespace-nowrap text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground sm:px-3">Resume</a>
        <a href="/#portfolio" class="inline-flex h-8 items-center rounded-md px-2 sm:px-3 text-sm font-medium whitespace-nowrap text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground">Portfolio</a>
        <button id="theme-toggle" type="button" aria-label="System theme" title="System theme"
          class="inline-flex size-8 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground cursor-pointer">
          <span class="material-symbols-outlined theme-icon text-[18px]">contrast</span>
        </button>
      </nav>
    </div>
  </header>

  <main class="mx-auto max-w-4xl px-6"><slot /></main>

  <footer class="mx-auto max-w-4xl px-6 pb-12">
    <div class="border-t pt-6 text-xs text-muted-foreground">
      Copyright &copy; {new Date().getFullYear()} Mike Vincent. Los Angeles, CA &middot; U.S. Citizen.
    </div>
  </footer>

  <script is:inline>
    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const mode = localStorage.getItem('theme') || 'system';
      localStorage.setItem('theme', mode === 'system' ? 'light' : mode === 'light' ? 'dark' : 'system');
      window.applyTheme();
    });
  </script>
</body>
</html>
