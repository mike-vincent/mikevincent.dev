---
import Base from '../layouts/Base.astro';
import Section from '../components/site/Section.astro';
import Row from '../components/site/Row.astro';
import { portfolio, projects, favicon } from '../content/portfolio';
import { roles, education, skills } from '../content/resume';

const button = 'inline-flex h-10 items-center rounded-md border bg-background px-6 text-sm font-medium shadow-xs transition-colors hover:bg-accent hover:text-accent-foreground';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://mikevincent.dev/#person',
      name: 'Mike Vincent',
      alternateName: ['Michael Vincent', 'Michael T. Vincent'],
      url: 'https://mikevincent.dev/',
      image: 'https://mikevincent.dev/assets/images/headshot.jpg',
      jobTitle: 'Staff Software Engineer',
      address: { '@type': 'PostalAddress', addressLocality: 'Los Angeles', addressRegion: 'CA', addressCountry: 'US' },
      sameAs: [
        'https://github.com/mike-vincent',
        'https://www.linkedin.com/in/michael-thomas-vincent/',
        'https://dev.to/mike-vincent',
        'https://www.radioindex.org/',
        'https://iopictures.com/',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://mikevincent.dev/#website',
      name: 'Mike Vincent',
      url: 'https://mikevincent.dev/',
      inLanguage: 'en-US',
      publisher: { '@id': 'https://mikevincent.dev/#person' },
    },
  ],
};
---
<Base
  title="Mike Vincent · Staff Software Engineer, Los Angeles"
  description="Michael Vincent, known as Mike, is a Staff Software Engineer in Los Angeles. He builds fraud and risk models for the Discover Global Network, search for Discover.com and CapitalOne.com, and fare-payment platforms for five US transit agencies."
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <header class="py-14 sm:py-20">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:gap-8">
        <div class="min-w-0">
          <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Mike Vincent</h1>
          <p class="mt-1.5 text-lg font-medium text-foreground">Staff Software Engineer</p>
          <p class="mt-4 text-base font-medium text-foreground">Los Angeles, California. U.S. Citizen.</p>
          <p class="mt-1.5 text-base text-muted-foreground">Banking, Payments, Infrastructure, AI/ML.</p>
        </div>
        <img src="/assets/images/headshot.jpg" alt="Mike Vincent" width="150" height="150"
          class="order-first size-36 shrink-0 rounded-full object-cover ring-1 ring-border sm:order-none sm:size-42" />
      </div>
      <div class="mt-6 flex flex-wrap gap-1.5">
        {['Engineering Manager', 'Architect', 'Software Engineer', 'Machine Learning Engineer', 'Data Engineer', 'AI Engineer', 'Security Engineer', 'Platform Engineer', 'Infrastructure Engineer'].map((p) => (
          <span class="inline-flex items-center rounded-md bg-secondary px-2.5 py-1 text-xs font-medium text-secondary-foreground">{p}</span>
        ))}
      </div>
      <nav aria-label="Primary" class="mt-6 flex flex-wrap gap-3">
        <a href="#resume" class="inline-flex h-10 items-center rounded-md bg-primary px-6 text-sm font-medium text-primary-foreground shadow-xs transition-colors hover:bg-primary/90">View Resume</a>
        <a href="#portfolio" class={button}>See Portfolio</a>
        <a href="https://github.com/mike-vincent" target="_blank" rel="noopener noreferrer" class={button}>GitHub</a>
        <a href="https://www.linkedin.com/in/michael-thomas-vincent/" target="_blank" rel="noopener noreferrer" class={button}>LinkedIn</a>
      </nav>
  </header>

  <Section id="about" label="About">
    <p class="max-w-3xl text-base leading-relaxed text-muted-foreground">
      Mike Vincent is an American software engineer and founder from Los Angeles who builds and
      runs payments and AI model platforms for well-known brands. He has worked as an engineering
      manager and staff engineer at companies including PwC, Capital One, Discover, and Fannie Mae.
    </p>
    <p class="mt-4 max-w-3xl text-base leading-relaxed text-muted-foreground">
      Read Mike’s articles on Python in the “<a href="https://dev.to/mike-vincent" target="_blank" rel="noopener noreferrer" class="underline-offset-4 hover:text-foreground hover:underline">Quark’s Outlines</a>” series.
      Listen to an old radio show at <a href="https://www.radioindex.org" target="_blank" rel="noopener noreferrer" class="underline-offset-4 hover:text-foreground hover:underline">radioindex.org</a>, which Mike builds and runs for The Archive of American Radio, Inc.
    </p>
  </Section>

  <Section id="resume" label="Experience">
    <a slot="actions" href="/resume.pdf" download="mikevincentresume.pdf" title="Download PDF" aria-label="Download resume PDF"
      class="inline-flex h-8 items-center gap-1.5 rounded-md px-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground">
      <span class="material-symbols-outlined text-[20px]" aria-hidden="true">download</span>
      <span>Download resume</span>
    </a>
    <ul class="space-y-8">
      {roles.map((r) => (
        <li>
          <Row name={`${r.title}, ${r.org}`} icon={favicon(r.url)} meta={r.period} description={r.blurb}>
            <ul class="mt-2 space-y-1.5">
              {r.bullets.map((b) => (
                <li class="flex gap-2.5 text-sm text-muted-foreground">
                  <span class="mt-2 size-1 shrink-0 rounded-full bg-muted-foreground/50"></span>
                  <span><span class="font-medium text-foreground">{b.lead}</span>. {/^[a-z]{2}/.test(b.text) ? b.text[0].toUpperCase() + b.text.slice(1) : b.text}</span>
                </li>
              ))}
            </ul>
          </Row>
        </li>
      ))}
    </ul>
  </Section>

  <Section id="portfolio" label="Portfolio">
    <ul class="grid gap-x-6 gap-y-5 sm:grid-cols-2">
      {portfolio.map((p) => <li><Row name={p.name} href={p.url} icon={p.icon ?? favicon(p.url)} description={p.description} /></li>)}
    </ul>
  </Section>

  <Section id="projects" label="Projects">
    <ul class="grid gap-x-6 gap-y-5 sm:grid-cols-2">
      {projects.map((p) => <li><Row name={p.name} href={p.url} icon={p.icon} description={p.description} /></li>)}
    </ul>
  </Section>

  <Section id="skills" label="Skills">
    <ul class="grid gap-x-6 gap-y-5 sm:grid-cols-2">
      {skills.map((s) => <li><Row name={s.group} description={s.items} /></li>)}
    </ul>
  </Section>

  <Section id="education" label="Education">
    <ul class="grid gap-x-6 gap-y-5 sm:grid-cols-2">
      {education.map((e) => <li><Row name={e.school} href={e.url} icon={favicon(e.url)} description={e.detail} /></li>)}
    </ul>
  </Section>
</Base>
