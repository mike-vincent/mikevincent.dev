---
import Base from '../layouts/Base.astro';
import Section from '../components/site/Section.astro';
import Row from '../components/site/Row.astro';
import { portfolio, projects, favicon } from '../content/portfolio';
import { roles, education, skills } from '../content/resume';

const button = 'inline-flex h-11 items-center rounded-full border bg-background px-5 text-subhead font-medium shadow-xs transition-colors hover:bg-accent hover:text-accent-foreground outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50';

const DESCRIPTION = 'Michael Vincent, known as Mike, is a Staff Software Engineer in Los Angeles. He builds cloud platforms on AWS and Azure with Kubernetes and Terraform, and payments infrastructure for Capital One and Discover.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://mikevincent.dev/#person',
      name: 'Mike Vincent',
      alternateName: ['Michael Vincent', 'Michael T. Vincent', 'Michael Thomas Vincent'],
      url: 'https://mikevincent.dev/',
      image: 'https://mikevincent.dev/assets/images/headshot.jpg',
      description: DESCRIPTION,
      jobTitle: 'Staff Software Engineer',
      worksFor: { '@type': 'Organization', name: 'PwC', url: 'https://www.pwc.com' },
      alumniOf: [
        { '@type': 'CollegeOrUniversity', name: 'University of Texas at Tyler', url: 'https://www.uttyler.edu' },
        { '@type': 'CollegeOrUniversity', name: 'The Pennsylvania State University', url: 'https://www.psu.edu' },
      ],
      knowsAbout: [
        'Cloud infrastructure', 'DevOps', 'Site reliability engineering', 'Platform engineering',
        'Kubernetes', 'Terraform', 'AWS', 'Azure', 'Docker', 'CI/CD', 'Payments', 'Machine learning',
      ],
      address: { '@type': 'PostalAddress', addressLocality: 'Los Angeles', addressRegion: 'CA', addressCountry: 'US' },
      sameAs: [
        'https://github.com/mike-vincent',
        'https://www.linkedin.com/in/michael-thomas-vincent/',
        'https://dev.to/mike-vincent',
        'https://www.radioindex.org/',
        'https://iopictures.com/',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://mikevincent.dev/#website',
      name: 'Mike Vincent',
      url: 'https://mikevincent.dev/',
      inLanguage: 'en-US',
      publisher: { '@id': 'https://mikevincent.dev/#person' },
    },
  ],
};
---
<Base
  title="Mike Vincent · Staff Software Engineer, Cloud and DevOps"
  description={DESCRIPTION}
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <header class="pt-3 pb-8">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between sm:gap-8">
        <div class="min-w-0">
          <h1 class="text-large-title font-semibold sm:text-display-md text-foreground">Mike Vincent</h1>
          <p class="mt-2 text-title-3 text-foreground">Staff Software Engineer</p>
          <p class="mt-4 text-body text-muted-foreground">Los Angeles, California. U.S. Citizen.</p>
          <p class="mt-1 text-body text-muted-foreground">Banking, Payments, Infrastructure, AI/ML.</p>
        </div>
        <img src="/assets/images/headshot-320.webp" alt="Mike Vincent" width="150" height="150" fetchpriority="high"
          srcset="/assets/images/headshot-168.webp 168w, /assets/images/headshot-320.webp 320w" sizes="(min-width: 40rem) 10.5rem, 9rem"
          class="order-first mt-12 size-36 shrink-0 rounded-full object-cover ring-1 ring-border sm:order-none sm:mt-14 sm:size-42" />
      </div>
      <div class="mt-6 flex flex-wrap gap-2">
        {['Engineering Manager', 'Architect', 'Platform Engineer', 'Infrastructure Engineer', 'DevOps Engineer', 'Cloud Engineer', 'Site Reliability Engineer', 'Software Engineer', 'Machine Learning Engineer', 'Data Engineer', 'AI Engineer', 'Security Engineer'].map((p) => (
          <span class="inline-flex items-center rounded-md bg-secondary px-2.5 py-1 text-footnote text-secondary-foreground">{p}</span>
        ))}
      </div>
      <nav aria-label="Primary" class="mt-6 flex flex-wrap gap-3">
        <a href="https://github.com/mike-vincent" target="_blank" rel="noopener noreferrer" class={button}>GitHub</a>
        <a href="https://www.linkedin.com/in/michael-thomas-vincent/" target="_blank" rel="noopener noreferrer" class={button}>LinkedIn</a>
      </nav>
  </header>

  <Section id="about" label="About">
    <p class="max-w-3xl text-body leading-[1.4706] text-muted-foreground">
      Mike Vincent is an American software engineer and founder from Los Angeles who builds and
      runs payments and AI model platforms for well-known brands. He has worked as an engineering
      manager and staff engineer at companies including PwC, Capital One, Discover, and Fannie Mae.
    </p>
    <p class="mt-4 max-w-3xl text-body leading-[1.4706] text-muted-foreground">
      Read Mike’s articles on Python in the “<a href="https://dev.to/mike-vincent" target="_blank" rel="noopener noreferrer" class="rounded-xs text-tint transition-opacity hover:opacity-80 outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50">Quark’s Outlines</a>” series.
      Listen to an old radio show at <a href="https://www.radioindex.org" target="_blank" rel="noopener noreferrer" class="rounded-xs text-tint transition-opacity hover:opacity-80 outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50">radioindex.org</a>, which Mike builds and runs for The Archive of American Radio, Inc.
    </p>
  </Section>

  <div id="view-switcher" class="border-t pt-8 pb-0">
    <div
      role="tablist"
      aria-label="View resume or portfolio"
      class="inline-grid h-11 w-full max-w-xs grid-cols-2 items-center rounded-full bg-secondary p-1 ring-1 ring-border"
    >
      <button
        id="tab-resume"
        type="button"
        role="tab"
        aria-selected="true"
        aria-controls="panel-resume"
        data-view="resume"
        class="h-9 rounded-full px-4 text-subhead font-medium transition-all cursor-pointer outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 bg-background text-tint shadow-xs"
      >
        Resume
      </button>
      <button
        id="tab-portfolio"
        type="button"
        role="tab"
        aria-selected="false"
        aria-controls="panel-portfolio"
        data-view="portfolio"
        class="h-9 rounded-full px-4 text-subhead font-medium transition-all cursor-pointer outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 text-muted-foreground hover:text-foreground"
      >
        Portfolio
      </button>
    </div>
  </div>

  <div id="panel-resume" role="tabpanel" aria-labelledby="tab-resume">
    <Section id="resume" label="Experience" borderless>
      <a slot="actions" href="/resume.pdf" download="mikevincentresume.pdf" title="Download PDF" aria-label="Download resume PDF"
        class="inline-flex h-11 items-center gap-1.5 rounded-md px-2.5 text-subhead font-medium text-tint transition-colors hover:bg-accent outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50">
        <span class="material-symbols-outlined text-[20px]" aria-hidden="true">download</span>
        <span>Download resume</span>
      </a>
      <ul class="space-y-6">
        {roles.map((r) => (
          <li>
            <Row name={`${r.title}, ${r.org}`} icon={favicon(r.url)} meta={r.period} description={r.blurb}>
              <ul class="mt-2 space-y-2">
                {r.bullets.map((b) => (
                  <li class="flex gap-2 text-subhead text-muted-foreground">
                    <span class="mt-2.5 size-1 shrink-0 rounded-full bg-muted-foreground/50"></span>
                    <span>{b.lead}. {/^[a-z]{2}/.test(b.text) ? b.text[0].toUpperCase() + b.text.slice(1) : b.text}</span>
                  </li>
                ))}
              </ul>
            </Row>
          </li>
        ))}
      </ul>
    </Section>

    <Section id="skills" label="Skills">
      <ul class="grid gap-x-8 gap-y-8 sm:grid-cols-2">
        {skills.map((s) => (
          <li>
            <h3 class="text-title-3 font-semibold text-foreground">{s.group}</h3>
            <dl class="mt-3 space-y-3">
              {s.bullets.map((b) => (
                <div>
                  <dt class="text-body font-medium text-foreground">{b.lead}</dt>
                  <dd class="text-subhead text-muted-foreground">{b.text}</dd>
                </div>
              ))}
            </dl>
          </li>
        ))}
      </ul>
    </Section>

    <Section id="education" label="Education">
      <ul class="grid gap-x-8 gap-y-6 sm:grid-cols-2">
        {education.map((e) => <li><Row name={e.school} href={e.url} icon={favicon(e.url)} description={e.detail} /></li>)}
      </ul>
    </Section>
  </div>

  <div id="panel-portfolio" role="tabpanel" aria-labelledby="tab-portfolio" hidden>
    <Section id="portfolio" label="Portfolio" borderless>
      <ul class="-my-3.5 grid sm:grid-cols-2 sm:gap-x-8">
        {portfolio.map((p) => <li class="group/item"><Row plainList name={p.name} href={p.url} icon={p.icon ?? favicon(p.url)} description={p.description} /></li>)}
      </ul>
    </Section>

    <Section id="projects" label="Projects">
      <ul class="-my-3.5 grid sm:grid-cols-2 sm:gap-x-8">
        {projects.map((p) => <li class="group/item"><Row plainList name={p.name} href={p.url} icon={p.icon} description={p.description} /></li>)}
      </ul>
    </Section>
  </div>

  <script is:inline>
    (function () {
      const tabs = Array.from(document.querySelectorAll('[role="tab"][data-view]'));
      const panels = {
        resume: document.getElementById('panel-resume'),
        portfolio: document.getElementById('panel-portfolio'),
      };
      const ACTIVE = ['bg-background', 'text-tint', 'shadow-xs'];
      const INACTIVE = ['text-muted-foreground', 'hover:text-foreground'];

      function setView(view, updateHash) {
        const target = view === 'portfolio' ? 'portfolio' : 'resume';
        tabs.forEach((tab) => {
          const selected = tab.dataset.view === target;
          tab.setAttribute('aria-selected', String(selected));
          ACTIVE.forEach((c) => tab.classList.toggle(c, selected));
          INACTIVE.forEach((c) => tab.classList.toggle(c, !selected));
        });
        if (panels.resume) panels.resume.hidden = target !== 'resume';
        if (panels.portfolio) panels.portfolio.hidden = target !== 'portfolio';
        if (updateHash && location.hash !== '#' + target) {
          history.replaceState(null, '', '#' + target);
        }
      }

      function syncFromHash(scroll) {
        const hash = location.hash.replace('#', '');
        if (hash === 'portfolio' || hash === 'projects') setView('portfolio', false);
        else if (hash === 'resume' || hash === 'skills' || hash === 'education') setView('resume', false);
        if (scroll && hash) {
          const el = document.getElementById(hash === 'resume' || hash === 'portfolio' ? 'view-switcher' : hash);
          if (el) el.scrollIntoView({ behavior: 'smooth' });
        }
      }

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => setView(tab.dataset.view, true));
      });
      window.addEventListener('hashchange', () => syncFromHash(true));
      syncFromHash(false);
    })();
  </script>
</Base>
