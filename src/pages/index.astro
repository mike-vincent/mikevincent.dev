---
import Base from '../layouts/Base.astro';
import Section from '../components/site/Section.astro';
import Row from '../components/site/Row.astro';
import { portfolio, projects, favicon } from '../content/portfolio';
import { roles, education, skills } from '../content/resume';

const button = 'inline-flex h-11 items-center rounded-full bg-secondary px-5 text-subhead font-medium text-foreground transition-colors hover:bg-accent hover:text-accent-foreground outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50';

const DESCRIPTION = 'Mike Vincent is a Staff Software Engineer and former Engineering Manager in Los Angeles, California building payments, tokenization, fraud ML, hybrid search, and Kubernetes platforms on AWS and Azure.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://mikevincent.dev/#person',
      name: 'Mike Vincent',
      alternateName: ['Michael Vincent', 'Michael T. Vincent', 'Michael Thomas Vincent'],
      url: 'https://mikevincent.dev/',
      image: 'https://mikevincent.dev/assets/images/headshot.jpg',
      description: DESCRIPTION,
      jobTitle: 'Staff Software Engineer',
      worksFor: { '@type': 'Organization', name: 'PwC', url: 'https://www.pwc.com' },
      alumniOf: [
        { '@type': 'CollegeOrUniversity', name: 'University of Texas at Tyler', url: 'https://www.uttyler.edu' },
        { '@type': 'CollegeOrUniversity', name: 'The Pennsylvania State University', url: 'https://www.psu.edu' },
      ],
      knowsAbout: [
        'Payments infrastructure', 'Tokenization', 'Fraud machine learning', 'Hybrid search',
        'Transformers', 'AI systems', 'Platform engineering', 'Kubernetes', 'Terraform',
        'AWS', 'Azure', 'Rust', 'Go', 'Python', 'TypeScript',
      ],
      address: { '@type': 'PostalAddress', addressLocality: 'Los Angeles', addressRegion: 'CA', addressCountry: 'US' },
      sameAs: [
        'https://github.com/mike-vincent',
        'https://www.linkedin.com/in/michael-thomas-vincent/',
        'https://dev.to/mike-vincent',
        'https://www.radioindex.org/',
        'https://iopictures.com/',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://mikevincent.dev/#website',
      name: 'Mike Vincent',
      url: 'https://mikevincent.dev/',
      inLanguage: 'en-US',
      publisher: { '@id': 'https://mikevincent.dev/#person' },
    },
  ],
};
---
<Base
  title="Mike Vincent · Staff Software Engineer — Payments, AI/ML & Platform Infrastructure"
  description={DESCRIPTION}
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <header class="pt-6 pb-8">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:gap-5">
        <img src="/assets/images/headshot-320.webp" alt="Mike Vincent" width="128" height="128" fetchpriority="high"
          srcset="/assets/images/headshot-168.webp 168w, /assets/images/headshot-320.webp 320w" sizes="(min-width: 40rem) 8rem, 6rem"
          class="size-24 shrink-0 rounded-full object-cover ring-1 ring-border sm:size-32" />
        <div class="min-w-0">
          <h1 class="text-large-title font-semibold sm:text-display-md text-foreground">Mike Vincent</h1>
          <div class="mt-3">
            <p class="text-title-3 text-foreground">Staff Software Engineer</p>
            <p class="mt-0.5 max-w-[20ch] text-body text-muted-foreground">Payments &amp; tokenization, fraud ML &amp; hybrid search, Kubernetes &amp; cloud platforms.</p>
          </div>
          <nav aria-label="Primary" class="mt-4 flex flex-wrap gap-3">
            <a href="https://github.com/mike-vincent" target="_blank" rel="noopener noreferrer" class={button}>GitHub</a>
            <a href="https://www.linkedin.com/in/michael-thomas-vincent/" target="_blank" rel="noopener noreferrer" class={button}>LinkedIn</a>
          </nav>
        </div>
      </div>
  </header>

  <div id="view-switcher" class="border-t pt-8 pb-0">
    <div id="about">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <h2 id="about-heading" class="text-title-1 font-semibold text-foreground">About</h2>
        <div
          role="tablist"
          aria-label="View resume or portfolio"
          class="inline-grid h-11 w-[220px] shrink-0 grid-cols-2 items-center rounded-full bg-secondary p-1 sm:w-[240px]"
        >
          <button
            id="tab-resume"
            type="button"
            role="tab"
            aria-selected="true"
            aria-controls="panel-resume"
            data-view="resume"
            class="h-9 rounded-full px-4 text-subhead font-medium transition-all cursor-pointer outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 bg-background text-tint shadow-xs"
          >
            Resume
          </button>
          <button
            id="tab-portfolio"
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="panel-portfolio"
            data-view="portfolio"
            class="h-9 rounded-full px-4 text-subhead font-medium transition-all cursor-pointer outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 text-muted-foreground hover:text-foreground"
          >
            Portfolio
          </button>
        </div>
      </div>
      <p class="mt-4 max-w-3xl text-body leading-[1.4706] text-muted-foreground">
        Mike Vincent is an American software engineer and founder from Los Angeles, California who
        builds and runs payments, cloud, and AI model platforms. He has worked as an engineering
        manager and lead engineer at PwC, shipping systems for Capital One, Discover, Fannie Mae,
        and U.S. transit agencies.
      </p>
      <p class="mt-3 text-subhead text-muted-foreground">Los Angeles, California. U.S. Citizen.</p>
    </div>
  </div>

  <div id="panel-resume" role="tabpanel" aria-labelledby="tab-resume">
    <Section id="resume" label="Experience" borderless>
      <a slot="actions" href="/resume.pdf" download="mikevincentresume.pdf" title="Download PDF" aria-label="Download resume PDF"
        class="inline-flex h-11 -my-2 items-center gap-1.5 rounded-md px-2.5 text-subhead font-medium text-tint transition-colors hover:bg-accent outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50">
        <span class="material-symbols-outlined text-[20px]" aria-hidden="true">download</span>
        <span>Download resume</span>
      </a>
      <ul class="space-y-6">
        {roles.map((r) => (
          <li>
            <Row name={`${r.title}, ${r.org}`} icon={favicon(r.url)} iconHref={r.url} iconLabel={r.org} meta={r.period} description={r.blurb}>
              <ul class="mt-3 space-y-3">
                {r.bullets.map((b) => (
                  <li class="flex gap-2.5 text-subhead text-muted-foreground">
                    <span class="mt-2.5 size-1 shrink-0 rounded-full bg-muted-foreground/50"></span>
                    <span class="flex flex-col">
                      <span class="font-medium text-foreground/90">{b.lead}</span>
                      <span>{b.text}</span>
                    </span>
                  </li>
                ))}
              </ul>
            </Row>
          </li>
        ))}
      </ul>
    </Section>

    <Section id="skills" label="Skills">
      <ul class="grid gap-x-8 gap-y-8 sm:grid-cols-2">
        {skills.map((s) => (
          <li>
            <h4 class="text-title-3 font-semibold text-foreground">{s.group}</h4>
            <dl class="mt-3 space-y-3">
              {s.bullets.map((b) => (
                <div>
                  <dt class="text-body font-medium text-foreground">{b.lead}</dt>
                  <dd class="text-subhead text-muted-foreground">{b.text}</dd>
                </div>
              ))}
            </dl>
          </li>
        ))}
      </ul>
    </Section>

    <Section id="education" label="Education">
      <ul class="grid gap-x-8 gap-y-6 sm:grid-cols-2">
        {education.map((e) => <li><Row name={e.school} href={e.url} icon={favicon(e.url)} description={e.detail} /></li>)}
      </ul>
    </Section>
  </div>

  <div id="panel-portfolio" role="tabpanel" aria-labelledby="tab-portfolio" hidden>
    <Section id="projects" label="Projects" borderless>
      <ul class="plain-list-grid -my-3.5 grid sm:grid-cols-2 sm:gap-x-8">
        {projects.map((p) => <li class="group/item"><Row plainList name={p.name} href={p.url} icon={p.icon} description={p.description} /></li>)}
      </ul>
    </Section>

    <Section id="portfolio" label="Products">
      <ul class="plain-list-grid -my-3.5 grid sm:grid-cols-2 sm:gap-x-8">
        {portfolio.map((p) => <li class="group/item"><Row plainList name={p.name} href={p.url} icon={p.icon ?? favicon(p.url)} description={p.description} /></li>)}
      </ul>
    </Section>
  </div>

  <script is:inline>
    (function () {
      const tabs = Array.from(document.querySelectorAll('[role="tab"][data-view]'));
      const panels = {
        resume: document.getElementById('panel-resume'),
        portfolio: document.getElementById('panel-portfolio'),
      };
      const ACTIVE = ['bg-background', 'text-tint', 'shadow-xs'];
      const INACTIVE = ['text-muted-foreground', 'hover:text-foreground'];

      function setView(view, updateHash) {
        const target = view === 'portfolio' ? 'portfolio' : 'resume';
        tabs.forEach((tab) => {
          const selected = tab.dataset.view === target;
          tab.setAttribute('aria-selected', String(selected));
          ACTIVE.forEach((c) => tab.classList.toggle(c, selected));
          INACTIVE.forEach((c) => tab.classList.toggle(c, !selected));
        });
        if (panels.resume) panels.resume.hidden = target !== 'resume';
        if (panels.portfolio) panels.portfolio.hidden = target !== 'portfolio';
        if (updateHash && location.hash !== '#' + target) {
          history.replaceState(null, '', '#' + target);
        }
      }

      function syncFromHash(scroll) {
        const hash = location.hash.replace('#', '');
        if (hash === 'portfolio' || hash === 'projects') setView('portfolio', false);
        else if (hash === 'resume' || hash === 'about' || hash === 'skills' || hash === 'education') setView('resume', false);
        if (scroll && hash) {
          const el = document.getElementById(hash === 'resume' || hash === 'portfolio' ? 'view-switcher' : hash);
          if (el) el.scrollIntoView({ behavior: 'smooth' });
        }
      }

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => setView(tab.dataset.view, true));
      });
      window.addEventListener('hashchange', () => syncFromHash(true));
      syncFromHash(false);
    })();
  </script>
</Base>
