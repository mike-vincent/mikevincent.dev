---
import { cn } from '../../lib/cn';
const { src, alt = '', fallback = '', class: className } = Astro.props;
---
<span class={cn('relative flex size-10 shrink-0 overflow-hidden rounded-full bg-muted', className)}>
  {src ? (
    <img src={src} alt={alt} class="aspect-square size-full object-cover" loading="lazy" />
  ) : (
    <span class="flex size-full items-center justify-center text-xs font-medium text-muted-foreground">{fallback}</span>
  )}
</span>
