---
import { cn } from '../../lib/cn';
const { variant = 'default', class: className, href, ...rest } = Astro.props;
const variants = {
  default: 'border-transparent bg-primary text-primary-foreground',
  secondary: 'border-transparent bg-secondary text-secondary-foreground',
  outline: 'text-foreground',
};
const cls = cn(
  'inline-flex items-center justify-center rounded-md border px-2 py-0.5 text-xs font-medium w-fit whitespace-nowrap shrink-0 gap-1 transition-colors',
  variants[variant],
  href && 'hover:bg-accent hover:text-accent-foreground',
  className
);
const Tag = href ? 'a' : 'span';
---
<Tag class={cls} href={href} {...rest}><slot /></Tag>
