---
// Invisible hooks for AI agents. In <head>: discovery links plus a tiny WebMCP script that
// registers read-only tools when the browser has modelContext. With `form`: a hidden
// declarative WebMCP form for the end of <body>. Nothing here renders or makes a request on load.
interface Props { form?: boolean }
const { form = false } = Astro.props;
---
{form ? (
  <form toolname="get_resume" tooldescription="Get Mike Vincent's resume as JSON Resume: work history, skills, education, projects, and profile links." action="/resume.json" method="get" hidden aria-hidden="true"></form>
) : (
  <>
    <link rel="ai-catalog" href="/.well-known/ai-catalog.json" />
    <link rel="api-catalog" href="/.well-known/api-catalog" />
    <link rel="describedby" type="text/plain" href="/llms.txt" />
    <script is:inline>
      (function () {
        var tools = [
          { name: 'get_resume', description: "Get Mike Vincent's resume as JSON Resume: work history, skills, education, projects, and profile links.", url: '/resume.json' },
          { name: 'get_profile_links', description: 'Get who Mike Vincent is and where to find or contact him: website, location, GitHub, LinkedIn, DEV, and resume PDF.', url: '/resume.json', basics: true }
        ];
        var done = false;
        var ctl = typeof AbortController === 'function' ? new AbortController() : null;
        function text(t) { return { content: [{ type: 'text', text: t }] }; }
        function register() {
          if (done) return;
          try {
            var mc = document.modelContext || navigator.modelContext;
            if (!mc || typeof mc.registerTool !== 'function') return;
            done = true;
            tools.forEach(function (t) {
              try {
                var p = mc.registerTool({
                  name: t.name,
                  description: t.description,
                  inputSchema: { type: 'object', properties: {}, additionalProperties: false },
                  annotations: { readOnlyHint: true },
                  execute: function () {
                    return fetch(t.url, { headers: { Accept: 'application/json' } }).then(function (r) { return r.json(); }).then(function (d) {
                      var b = d.basics || {};
                      var out = t.basics ? { name: b.name, label: b.label, url: b.url, location: b.location, profiles: b.profiles, resumePdf: 'https://mikevincent.dev/resume.pdf' } : d;
                      return text(JSON.stringify(out));
                    }).catch(function (e) { var r = text('Could not load ' + t.url + ': ' + e); r.isError = true; return r; });
                  }
                }, ctl ? { signal: ctl.signal } : undefined);
                if (p && typeof p.catch === 'function') p.catch(function () {});
              } catch (e) {}
            });
          } catch (e) {}
        }
        register();
        document.addEventListener('DOMContentLoaded', register);
        window.addEventListener('load', register);
      })();
    </script>
  </>
)}
