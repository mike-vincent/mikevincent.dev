---
// One list row: 44px icon, bold name, optional meta and grey line under it, optional slot below.
interface Props { name: string; href?: string; icon?: string; meta?: string; description?: string; }
const { name, href, icon, meta, description } = Astro.props;
const Tag = href ? 'a' : 'div';
const external = href?.startsWith('http');
---
<Tag
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  class="group flex items-start gap-3.5"
>
  {icon && <img src={icon} alt="" width="44" height="44" loading="lazy" class="size-10 shrink-0 rounded-[10px] bg-white object-contain p-1 ring-1 ring-border sm:size-11" />}
  <span class="flex min-w-0 flex-1 flex-col gap-0.5">
    <span class="flex flex-col">
      <strong class="text-[15px] font-semibold leading-snug underline-offset-4 group-hover:underline">{name}</strong>
      {meta && <span class="whitespace-nowrap text-sm text-muted-foreground">{meta}</span>}
    </span>
    {description && <span class="text-sm text-muted-foreground">{description}</span>}
    <slot />
  </span>
</Tag>
