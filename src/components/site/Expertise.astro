---
interface Brand { name: string; domain: string }
interface Domain { name: string; line: string; brands: Brand[]; tags: string[] }

const domains: Domain[] = [
  {
    name: 'Fraud & Risk Models',
    line: 'Current work. Fraud and risk models for the Discover Global Network, a global payments network. This includes prohibited-transaction detection required under UIGEA and Regulation GG, plus the platform that serves those models in production.',
    brands: [
      { name: 'Discover Global Network', domain: 'discoverglobalnetwork.com' },
      { name: 'PwC', domain: 'pwc.com' },
    ],
    tags: ['Global payments network', 'Fraud models', 'Risk models', 'Model serving', 'Real-time inference', 'Feature pipelines', 'UIGEA / Reg GG', 'Payments risk'],
  },
  {
    name: 'AI & Machine Learning',
    line: 'NLU, entity and intent models behind the Capital One Eno chatbot, running on Capital One’s enterprise AI platform. Transit demand and real time arrival prediction for UMO IQ and NextBus, built in SageMaker with TensorFlow and PySpark.',
    brands: [
      { name: 'Capital One', domain: 'capitalone.com' },
      { name: 'Discover', domain: 'discover.com' },
      { name: 'UMO IQ', domain: 'umoiq.com' },
      { name: 'NextBus', domain: 'nextbus.com' },
      { name: 'SF Muni', domain: 'sfmta.com' },
    ],
    tags: ['LLMs', 'AI agents', 'RAG', 'MLOps', 'Kubeflow', 'TensorFlow', 'SageMaker', 'PySpark'],
  },
  {
    name: 'Search & Model Inference',
    line: 'Hybrid retrieval for Discover.com and CapitalOne.com over vector embeddings and BM25, scored on offline evaluation sets that measure answer quality. Enterprise intranet search for Lockheed Martin, and hybrid search for Radio Index, an old-time-radio catalog.',
    brands: [
      { name: 'Discover', domain: 'discover.com' },
      { name: 'Capital One', domain: 'capitalone.com' },
      { name: 'Lockheed Martin', domain: 'lockheedmartin.com' },
      { name: 'Radio Index', domain: 'radioindex.org' },
    ],
    tags: ['Hybrid search', 'Vector search', 'BM25', 'ANN/KNN', 'Autocomplete', 'Offline eval', 'Lucene', 'Solr'],
  },
  {
    name: 'Payments',
    line: 'Fraud scoring on the Discover Global Network, Zelle transfer APIs, Capital One Databolt vaultless tokenization, and contactless iPhone fare payments with Apple for NYC MTA OMNY, all under PCI.',
    brands: [
      { name: 'Discover Global Network', domain: 'discoverglobalnetwork.com' },
      { name: 'Zelle', domain: 'zellepay.com' },
      { name: 'Capital One', domain: 'capitalone.com' },
      { name: 'NYC MTA', domain: 'new.mta.info' },
      { name: 'LA Metro', domain: 'metro.net' },
      { name: 'Apple', domain: 'apple.com' },
    ],
    tags: ['Fraud scoring', 'Zelle', 'Tokenization', 'Card data', 'Apple Pay', 'PCI DSS', 'Fare payments'],
  },
  {
    name: 'Infrastructure & Distributed Systems',
    line: 'Three clouds, one set of pipelines. Transit-payment SaaS across five agencies serving millions of riders, with KEDA autoscaling on AWS and Azure.',
    brands: [
      { name: 'DC Metro', domain: 'wmata.com' },
      { name: 'NYC MTA', domain: 'new.mta.info' },
      { name: 'BART', domain: 'bart.gov' },
      { name: 'LA Metro', domain: 'metro.net' },
      { name: 'Boston MBTA', domain: 'mbta.com' },
    ],
    tags: ['AWS', 'Azure', 'GCP', 'Kubernetes', 'Terraform', 'Istio', 'KEDA', 'Kafka', 'Redis'],
  },
  {
    name: 'Security & Compliance',
    line: 'PCI, SOC 1 and 2, ISO and SOX audits passed on fare-payment platforms. mTLS with a Smallstep private certificate authority across the Cubic fleet.',
    brands: [
      { name: 'Capital One', domain: 'capitalone.com' },
      { name: 'Cubic', domain: 'cubic.com' },
      { name: 'LA Metro', domain: 'metro.net' },
      { name: 'NYC MTA', domain: 'new.mta.info' },
    ],
    tags: ['mTLS', 'Private CA', 'CrowdStrike', 'Nessus', 'PCI', 'SOC 2', 'ISO', 'SOX'],
  },
  {
    name: 'Full Stack & Operations',
    line: 'Ships the interface and carries the pager. The Fannie Mae Collateral Underwriter SPA, Poison Control on iPhone and Android built with Cordova, and on-call incident response behind it all.',
    brands: [
      { name: 'Fannie Mae', domain: 'fanniemae.com' },
      { name: 'Poison Control', domain: 'poison.org' },
      { name: 'Canadian Tire', domain: 'canadiantire.ca' },
      { name: 'USCCB', domain: 'usccb.org' },
    ],
    tags: ['Go', 'Python', 'Java', 'TypeScript', 'React', 'Cordova', 'SwiftUI', 'SRE', 'Prometheus', 'Grafana'],
  },
];
---
  <div class="mb-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {domains.map((d) => (
      <div class="flex h-full flex-col gap-3 rounded-xl border bg-card p-5 text-card-foreground shadow-sm">
        <h3 class="text-base font-semibold leading-snug">{d.name}</h3>
        <p class="flex-1 text-sm text-muted-foreground">{d.line}</p>

        <div class="flex flex-wrap gap-1.5 pt-0.5">
          {d.brands.map((b) => (
            <span class="inline-flex items-center gap-1.5 rounded-md bg-secondary px-2 py-1 text-xs font-medium text-secondary-foreground">
              <img
                src={`https://www.google.com/s2/favicons?domain=${b.domain}&sz=32`}
                alt=""
                width="14"
                height="14"
                loading="lazy"
                class="size-3.5 rounded-[3px]"
              />
              {b.name}
            </span>
          ))}
        </div>

        <div class="mt-auto flex flex-wrap gap-1.5 border-t pt-3">
          {d.tags.map((t) => (
            <span class="inline-flex items-center rounded-md border px-2 py-0.5 text-xs font-medium text-muted-foreground">{t}</span>
          ))}
        </div>
      </div>
    ))}
  </div>
