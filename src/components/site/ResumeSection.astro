---
import { roles, education, projects, skills } from '../../content/resume';
---
<section id="resume" aria-labelledby="resume-heading" class="py-14">
  <div class="mb-6 flex items-center gap-2">
    <h2 id="resume-heading" class="text-2xl font-semibold tracking-tight">Resume</h2>
    <button type="button" onclick="sharePage()" title="Share" aria-label="Share this page"
      class="inline-flex size-8 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground cursor-pointer">
      <span class="material-symbols-outlined text-[20px]">ios_share</span>
    </button>
    <a href="/resume.pdf" download="mikevincentresume.pdf" title="Download PDF" aria-label="Download resume PDF"
      class="inline-flex size-8 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground">
      <span class="material-symbols-outlined text-[20px]">download</span>
    </a>
  </div>
  <p class="mt-2 text-xl font-semibold">Mike Vincent</p>
  <p class="mt-1 text-sm text-muted-foreground">
    Los Angeles, CA &middot; U.S. Citizen &middot;
    <a href="https://mikevincent.dev" class="font-medium text-foreground underline underline-offset-4">mikevincent.dev</a>
  </p>

  <h3 class="mt-10 mb-4 text-sm font-semibold uppercase tracking-widest text-muted-foreground">Education</h3>
  <div class="grid gap-3 sm:grid-cols-2">
    {education.map((e) => (
      <article class="rounded-xl border bg-card p-5 text-card-foreground shadow-sm">
        <h4 class="text-base font-semibold leading-snug">{e.school}</h4>
        <p class="mt-1.5 text-sm text-muted-foreground">{e.detail}</p>
      </article>
    ))}
  </div>

  <h3 class="mt-10 mb-4 text-sm font-semibold uppercase tracking-widest text-muted-foreground">Experience</h3>
  <div class="space-y-3">
    {roles.map((r) => (
      <article class="rounded-xl border bg-card p-5 text-card-foreground shadow-sm">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h4 class="text-base font-semibold leading-snug">{r.title}</h4>
          <span class="whitespace-nowrap text-sm text-muted-foreground">{r.period}</span>
        </div>
        <p class="mt-1 text-sm text-muted-foreground">{r.org}{r.location ? ` · ${r.location}` : ''}</p>
        <p class="mt-3 text-sm text-foreground/90">{r.blurb}</p>
        <ul class="mt-3 space-y-2 border-t pt-3">
          {r.bullets.map((b) => (
            <li class="flex gap-2.5 text-sm text-muted-foreground">
              <span class="mt-2 size-1 shrink-0 rounded-full bg-muted-foreground/50"></span>
              <span>{b.lead && <span class="font-medium text-foreground">{b.lead}</span>}{b.lead ? '. ' : ''}{b.text}</span>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>

  <h3 class="mt-10 mb-4 text-sm font-semibold uppercase tracking-widest text-muted-foreground">Projects</h3>
  <div class="grid gap-3 sm:grid-cols-2">
    {projects.map((p) => (
      <article class="rounded-xl border bg-card p-5 text-card-foreground shadow-sm">
        <h4 class="text-base font-semibold leading-snug">{p.name}</h4>
        <p class="mt-2 text-sm text-muted-foreground">{p.text}</p>
      </article>
    ))}
  </div>

  <h3 class="mt-10 mb-4 text-sm font-semibold uppercase tracking-widest text-muted-foreground">Skills</h3>
  <div class="grid gap-3 sm:grid-cols-2">
    {skills.map((s) => (
      <article class="rounded-xl border bg-card p-5 text-card-foreground shadow-sm">
        <h4 class="text-sm font-semibold">{s.group}</h4>
        <div class="mt-2.5 flex flex-wrap gap-1.5">
          {s.items.split(',').map((t) => (
            <span class="inline-flex items-center rounded-md border px-2 py-0.5 text-xs font-medium text-muted-foreground">{t.trim()}</span>
          ))}
        </div>
      </article>
    ))}
  </div>
</section>
