---
import { brands, getDomain } from '../../content/portfolio';
---
<section id="portfolio" aria-labelledby="portfolio-heading" class="py-14">
  <div class="mb-6">
    <h2 id="portfolio-heading" class="text-2xl font-semibold tracking-tight">{Astro.props.heading ?? "Portfolio"}</h2>
  </div>
  <slot />
  <ul class="grid gap-3 sm:grid-cols-2">
    {brands.map((b) => (
      <li>
        <a
          href={b.url}
          target="_blank"
          rel="noopener noreferrer"
          class="flex h-full items-start gap-3 rounded-xl border bg-card p-4 text-card-foreground shadow-sm transition-colors hover:bg-accent/40 hover:border-ring/40"
        >
          <img
            src={`https://www.google.com/s2/favicons?domain=${getDomain(b.url)}&sz=64`}
            alt=""
            width="28"
            height="28"
            loading="lazy"
            class="mt-0.5 size-6 shrink-0 rounded-md sm:size-7"
          />
          <span class="flex flex-col gap-0.5">
            <strong class="text-sm font-medium leading-snug">{b.name}</strong>
            <small class="text-sm text-muted-foreground">{b.description}</small>
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>
