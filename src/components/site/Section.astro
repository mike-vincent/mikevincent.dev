---
// A page section: hairline above, Apple Title 1 heading, then its rows.
interface Props { id: string; label: string; borderless?: boolean; }
const { id, label, borderless = false } = Astro.props;
---
<section id={id} aria-labelledby={`${id}-heading`} class={borderless ? 'pt-6 pb-10' : 'border-t py-10'}>
  <div class="mb-5 flex min-h-11 items-center gap-3">
    <h2 id={`${id}-heading`} class="text-title-1 font-semibold text-foreground">{label}</h2>
    <slot name="actions" />
  </div>
  <slot />
</section>
