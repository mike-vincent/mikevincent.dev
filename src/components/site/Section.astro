---
// A subsection inside Resume or Portfolio: hairline above, Apple Title 2 (22px) h3 heading, then its rows.
interface Props { id: string; label: string; borderless?: boolean; }
const { id, label, borderless = false } = Astro.props;
---
<section id={id} aria-labelledby={`${id}-heading`} class={borderless ? 'pt-6 pb-8' : 'border-t py-8'}>
  <div class="mb-4 flex items-center gap-3">
    <h3 id={`${id}-heading`} class="text-title-2 font-semibold text-foreground">{label}</h3>
    <slot name="actions" />
  </div>
  <slot />
</section>
