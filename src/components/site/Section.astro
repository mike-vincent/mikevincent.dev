---
// A page section: hairline above, Apple Title 2 heading, then its rows.
interface Props { id: string; label: string; }
const { id, label } = Astro.props;
---
<section id={id} aria-labelledby={`${id}-heading`} class="border-t py-10">
  <div class="mb-5 flex items-center gap-3">
    <h2 id={`${id}-heading`} class="type-title-2 text-foreground">{label}</h2>
    <slot name="actions" />
  </div>
  <slot />
</section>
